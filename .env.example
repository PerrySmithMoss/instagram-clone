# Firebase web app configuration from Firebase Console > Project settings.
# These client identifiers are public; do not add service-account or OAuth secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-instagram-clone.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-instagram-clone
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-instagram-clone.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demo
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-DEMO
